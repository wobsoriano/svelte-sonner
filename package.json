{
	"name": "svelte-sonner",
	"description": "An opinionated toast component for Svelte.",
	"license": "MIT",
	"author": "Robert Soriano <sorianorobertc@gmail.com>",
	"homepage": "https://github.com/wobsoriano/svelte-sonner#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wobsoriano/svelte-sonner.git"
	},
	"bugs": "https://github.com/wobsoriano/svelte-sonner/issues",
	"keywords": [
		"svelte",
		"toast"
	],
	"version": "1.2.3",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run build",
		"test": "playwright test",
		"test:unit": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"release": "pnpm run package && changeset publish",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.7",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"copy-to-clipboard": "^3.3.3",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^16.5.0",
		"highlight.js": "^11.11.1",
		"jsdom": "^24.1.3",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.2.12",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@sveltejs/kit",
			"esbuild"
		]
	},
	"sideEffects": false,
	"packageManager": "pnpm@10.20.0"
}
